{
  "name": "wizard-ccna",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "WizardCCNA — a complete CCNA 200-301 study platform: goal-date study plan, slide decks, flashcards, network lab simulator and practice exams.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "validate": "vitest run src/content/validate.test.ts",
    "test:sim": "vitest run src/sim",
    "test:labs": "vitest run src/content/labs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.0",
    "lucide-react": "^1.48.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.18.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
